# Copy this file to .env and fill in real values. .env is gitignored.

# --- LLM provider ---
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key-here
# OPENAI_API_KEY is not required yet (Groq only for now). Added during the
# evaluation phase when we compare providers.
OPENAI_API_KEY=

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql://finrag:finrag@localhost:5432/finrag
