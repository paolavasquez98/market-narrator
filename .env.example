# Copy this file to .env and fill in real values. .env is gitignored.

# --- LLM provider ---
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key-here
# The OpenAI provider was never implemented (llm/factory.py raises
# NotImplementedError for it) -- a second judge model would have reduced
# the LLM-as-judge self-preference bias documented in
# docs/learning/day05_learning.md, but wasn't built given the project
# timeline. Leave this blank; it isn't read by anything yet.
OPENAI_API_KEY=

# --- Database ---
# localhost is correct for running the API directly on the host
# (`uv run uvicorn ...`). docker-compose.yml's `api` service overrides
# this to postgresql://finrag:finrag@db:5432/finrag automatically --
# "db" is the Postgres service's name on the compose network, not a
# routable host port. See docs/deployment.md.
DATABASE_URL=postgresql://finrag:finrag@localhost:5432/finrag

# --- API / UI ---
# Where ui/app.py finds the FastAPI service. Same localhost-vs-compose
# story as DATABASE_URL above -- docker-compose.yml's `ui` service
# overrides this to http://api:8000.
API_BASE_URL=http://localhost:8000
