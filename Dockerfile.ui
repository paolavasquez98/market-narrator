# Streamlit frontend image. Build from the repo root:
#   docker build -f Dockerfile.ui -t market-narrator-ui .
# (docker-compose.yml's `ui` service does this automatically.)
#
# Lighter than Dockerfile.api: ui/app.py only imports finrag.config for
# settings (the API base URL) -- it never touches fastembed/onnxruntime,
# so no libgomp or model cache volume is needed here.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /uvx /usr/local/bin/

WORKDIR /app

COPY pyproject.toml uv.lock README.md  ./
RUN uv sync --frozen --no-install-project --no-dev

COPY src/ ./src/
RUN uv sync --frozen --no-dev

COPY ui/ ./ui/

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

EXPOSE 8501

CMD ["streamlit", "run", "ui/app.py", "--server.address=0.0.0.0", "--server.port=8501"]
